+fun Context.loadSimPhonebookContactsAsync(callback: (ArrayList<Contact>) -> Unit) {
+    var shouldStartLoad = false
+    val cached = synchronized(simPhonebookLoadLock) {
+        if (simPhonebookContactsLoaded) {
+            ArrayList(cachedSimPhonebookContacts)
+        } else {
+            simPhonebookLoadCallbacks += callback
+            if (!simPhonebookLoadInFlight) {
+                simPhonebookLoadInFlight = true
+                shouldStartLoad = true
+            }
+            null
+        }
+    }
+
+    if (cached != null) {
+        callback(cached)
+        return
+    }
+
+    if (!shouldStartLoad) {
+        return
+    }
+
+    val appContext = applicationContext
+    Thread {
+        val loaded = appContext.getSimPhonebookContacts()
+        val callbacks = synchronized(simPhonebookLoadLock) {
+            simPhonebookContactsLoaded = true
+            simPhonebookLoadInFlight = false
+            simPhonebookLoadCallbacks.toList().also { simPhonebookLoadCallbacks.clear() }
+        }
+
+        callbacks.forEach { it(ArrayList(loaded)) }
+    }.start()
+}
