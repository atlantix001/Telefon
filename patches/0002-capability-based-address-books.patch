 /**
- * Hard allow-list used by the custom Phone build.
+ * Returns whether ContactsProvider already contains a concrete source with this account name/type.
  *
- * The regular Android ContactsProvider remains untouched. This app only displays real local
- * device storage and DAVx5 address-book accounts. Direct SIM phonebook sources are appended
- * separately because they live outside ContactsProvider.
+ * This is only a fallback for providers that do not participate in Android's sync framework. It is
+ * intentionally scoped to the concrete source, so merely installing an app/account type that is
+ * capable of CardDAV is not enough to make an unrelated account appear as an address book.
+ */
+private fun Context.hasContactsProviderSource(source: ContactSource): Boolean {
+    val selection = "${ContactsContract.RawContacts.ACCOUNT_NAME} = ? AND ${ContactsContract.RawContacts.ACCOUNT_TYPE} = ?"
+    val selectionArgs = arrayOf(source.name, source.type)
+
+    fun hasRow(uri: Uri): Boolean = runCatching {
+        contentResolver.query(
+            uri,
+            arrayOf(ContactsContract.RawContacts.ACCOUNT_NAME),
+            selection,
+            selectionArgs,
+            null,
+        )?.use { cursor -> cursor.moveToFirst() } ?: false
+    }.getOrDefault(false)
+
+    return hasRow(ContactsContract.Settings.CONTENT_URI) ||
+        hasRow(ContactsContract.Groups.CONTENT_URI) ||
+        hasRow(ContactsContract.RawContacts.CONTENT_URI)
+}
+
+/**
+ * Decides per concrete Android account, not merely per account type.
+ *
+ * Fossify Commons currently accepts AccountManager entries with getIsSyncable() >= 0. That also
+ * includes 0 (not syncable), which can surface calendar-only or otherwise unrelated accounts if
+ * their provider happens to support contacts in principle. Here an account-backed source is shown
+ * only while contacts sync for that exact account is both syncable and enabled.
+ *
+ * A provider that does not use Android's sync framework can still qualify through an actual row in
+ * ContactsProvider. The fallback is used only when Android reports an unknown syncability state;
+ * an explicitly disabled/not-syncable account never falls through to it.
+ */
+private fun Context.isContactAddressBookAccount(source: ContactSource): Boolean {
+    if (source.name.isBlank() || source.type.isBlank() || source.type in NON_ADDRESS_BOOK_ACCOUNT_TYPES) {
+        return false
+    }
+
+    val account = Account(source.name, source.type)
+    val syncable = runCatching {
+        ContentResolver.getIsSyncable(account, ContactsContract.AUTHORITY)
+    }.getOrDefault(-1)
+    val syncAutomatically = runCatching {
+        ContentResolver.getSyncAutomatically(account, ContactsContract.AUTHORITY)
+    }.getOrDefault(false)
+
+    if (syncable > 0 && syncAutomatically) {
+        return true
+    }
+
+    // 0 means explicitly not syncable. A positive value with auto-sync off means contacts sync is
+    // configured but disabled. In both cases this source should stay out of the filter list.
+    if (syncable >= 0) {
+        return false
+    }
+
+    // Unknown sync state: allow only a source that demonstrably exists in ContactsProvider.
+    return hasContactsProviderSource(source)
+}
