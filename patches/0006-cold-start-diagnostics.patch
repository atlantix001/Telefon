new file mode 100644
index 0000000..228d77c
--- /dev/null
+++ b/app/src/main/kotlin/org/fossify/phone/helpers/ColdStartTrace.kt
@@ -0,0 +1,14 @@
+package org.fossify.phone.helpers
+
+import android.os.SystemClock
+import android.util.Log
+
+object ColdStartTrace {
+    private const val TAG = "FossifyColdStart"
+    private val baseMs = SystemClock.elapsedRealtime()
+
+    fun mark(message: String) {
+        val elapsed = SystemClock.elapsedRealtime() - baseMs
+        Log.i(TAG, "+${elapsed}ms [${Thread.currentThread().name}] $message")
+    }
+}
