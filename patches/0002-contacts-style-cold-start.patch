+package org.fossify.phone.helpers
+
+import android.content.Context
+import android.provider.ContactsContract.RawContacts
+import org.fossify.commons.extensions.getEmptyContact
+import org.fossify.commons.models.contacts.Contact
+import org.fossify.commons.models.contacts.ContactSource
+import org.fossify.phone.extensions.config
+import org.fossify.phone.extensions.isAllowedContactSource
+import java.util.Locale
+
+/**
+ * Lightweight cold-start preview for the Phone contacts tab.
+ *
+ * The normal ContactsHelper result remains authoritative and replaces this preview. RawContacts
+ * avoids the much heavier one-row-per-data-item Data view and is sufficient for an immediate
+ * name/source first paint after a reboot.
+ *
+ * This preview intentionally does not hydrate phone numbers; it only exists until the normal
+ * contact load arrives.
+ */
+fun Context.getFastVisiblePhoneContactPreview(): ArrayList<Contact> {
+    val contacts = LinkedHashMap<Int, Contact>()
+    val ignoredSources = config.ignoredContactSources
+
+    val projection = arrayOf(
+        RawContacts._ID,
+        RawContacts.CONTACT_ID,
+        RawContacts.ACCOUNT_NAME,
+        RawContacts.ACCOUNT_TYPE,
+        RawContacts.DISPLAY_NAME_PRIMARY,
+    )
+
+    runCatching {
+        contentResolver.query(
+            RawContacts.CONTENT_URI,
+            projection,
+            "${RawContacts.DELETED} = 0",
+            null,
+            RawContacts.SORT_KEY_PRIMARY,
+        )?.use { cursor ->
+            val rawIdIndex = cursor.getColumnIndexOrThrow(RawContacts._ID)
+            val contactIdIndex = cursor.getColumnIndexOrThrow(RawContacts.CONTACT_ID)
+            val accountNameIndex = cursor.getColumnIndexOrThrow(RawContacts.ACCOUNT_NAME)
+            val accountTypeIndex = cursor.getColumnIndexOrThrow(RawContacts.ACCOUNT_TYPE)
+            val displayNameIndex = cursor.getColumnIndexOrThrow(RawContacts.DISPLAY_NAME_PRIMARY)
+
+            while (cursor.moveToNext()) {
+                val accountName = cursor.getString(accountNameIndex).orEmpty()
+                val accountType = cursor.getString(accountTypeIndex).orEmpty()
+                val source = ContactSource(accountName, accountType, accountName)
+                if (!isAllowedContactSource(source) || source.getFullIdentifier() in ignoredSources) {
+                    continue
+                }
+
+                val displayName = cursor.getString(displayNameIndex).orEmpty().trim()
+                if (displayName.isBlank()) {
+                    continue
+                }
+
+                val rawId = cursor.getInt(rawIdIndex)
+                contacts[rawId] = getEmptyContact().copy(
+                    id = rawId,
+                    firstName = displayName,
+                    source = accountName,
+                    contactId = cursor.getInt(contactIdIndex),
+                )
+            }
+        }
+    }
+
+    val result = contacts.values.sortedBy { it.firstName.lowercase(Locale.getDefault()) }
+    return ArrayList(result)
+}
