+/**
+ * Runs the slow SIM provider query off the caller path. Concurrent startup consumers share one
+ * in-flight read so Contacts, cache warm-up and Dialpad do not hammer SimPhonebookContract in
+ * parallel. A later call starts a fresh read, so the process-lifetime cache is not authoritative.
+ */
+fun Context.getSimPhonebookContactsAsync(callback: (ArrayList<Contact>) -> Unit) {
+    val shouldStartLoad = synchronized(simPhonebookContactsLoadLock) {
+        pendingSimPhonebookContactCallbacks += callback
+        if (isSimPhonebookContactsLoadInProgress) {
+            false
+        } else {
+            isSimPhonebookContactsLoadInProgress = true
+            true
+        }
+    }
+
+    if (!shouldStartLoad) {
+        return
+    }
+
+    Thread {
+        val contacts = getSimPhonebookContacts()
+        val callbacks = synchronized(simPhonebookContactsLoadLock) {
+            isSimPhonebookContactsLoadInProgress = false
+            val waiting = ArrayList(pendingSimPhonebookContactCallbacks)
+            pendingSimPhonebookContactCallbacks.clear()
+            waiting
+        }
+
+        callbacks.forEach { pendingCallback ->
+            runCatching { pendingCallback(ArrayList(contacts)) }
+        }
+    }.start()
+}
