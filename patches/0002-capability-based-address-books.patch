 /**
- * Hard allow-list used by the custom Phone build.
+ * Returns whether an account-backed source behaves like a real Android contact address book.
  *
- * The regular Android ContactsProvider remains untouched. This app only displays real local
- * device storage and DAVx5 address-book accounts. Direct SIM phonebook sources are appended
- * separately because they live outside ContactsProvider.
+ * Do not require SyncAdapter.isUserVisible() or supportsUploading(): legitimate CardDAV providers
+ * do not report those flags consistently. We instead accept a ContactsContract SyncAdapter, or a
+ * concrete account that Android marks syncable for the contacts authority. Known messenger-only
+ * mirrors stay excluded explicitly.
+ */
+private fun isContactAddressBookAccount(source: ContactSource): Boolean {
+    if (source.name.isBlank() || source.type.isBlank() || source.type in NON_ADDRESS_BOOK_ACCOUNT_TYPES) {
+        return false
+    }
+
+    val account = Account(source.name, source.type)
+
+    // Google is useful as a filter source only while Contacts sync is enabled for this account.
+    // Intentionally ignore the global master-sync switch: disabling all background sync temporarily
+    // should not make a configured Google address book disappear from Fossify.
+    if (source.type == GOOGLE_ACCOUNT_TYPE) {
+        val contactsSyncEnabled = runCatching {
+            ContentResolver.getSyncAutomatically(account, ContactsContract.AUTHORITY)
+        }.getOrDefault(false)
+        if (!contactsSyncEnabled) {
+            return false
+        }
+    }
+
+    val hasContactsSyncAdapter = ContentResolver.getSyncAdapterTypes().any { adapter ->
+        adapter.authority == ContactsContract.AUTHORITY && adapter.accountType == source.type
+    }
+    if (hasContactsSyncAdapter) {
+        return true
+    }
+
+    // Fallback for CardDAV/contact providers that populate ContactsProvider but do not expose the
+    // usual SyncAdapter metadata. This remains provider-neutral and uses the concrete account.
+    return runCatching {
+        ContentResolver.getIsSyncable(account, ContactsContract.AUTHORITY) > 0
+    }.getOrDefault(false)
+}
